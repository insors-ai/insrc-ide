		"commandCenter.foreground": "#c0dcc8",
		"commandCenter.background": "#242c28",
		"commandCenter.border": "#2c3430",
		"commandCenter.activeForeground": "#ffffff",
		"commandCenter.activeBackground": "#82c49e30"
	},
	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#6ab0a2", "fontStyle": "italic" }
		},
		{
			"name": "Strings",
			"scope": ["string", "string.quoted"],
			"settings": { "foreground": "#82c49e" }
		},
		{
			"name": "Regular expressions",
			"scope": ["string.regexp"],
			"settings": { "foreground": "#a0d8b4" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#a0c840" }
		},
		{
			"name": "Language constants",
			"scope": ["constant.language"],
			"settings": { "foreground": "#b090d0" }
		},
		{
			"name": "Character escapes",
			"scope": ["constant.character.escape"],
			"settings": { "foreground": "#8a80d0" }
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "keyword.other"],
			"settings": { "foreground": "#b090d0" }
		},
		{
			"name": "Control keywords",
			"scope": ["keyword.control"],
			"settings": { "foreground": "#b090d0", "fontStyle": "bold" }
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#a0d8b4" }
		},
		{
			"name": "Storage types",
			"scope": ["storage.type", "storage"],
			"settings": { "foreground": "#8a80d0" }
		},
		{
			"name": "Storage modifiers",
			"scope": ["storage.modifier"],
			"settings": { "foreground": "#8a80d0", "fontStyle": "italic" }
		},
		{
			"name": "Function declarations",
			"scope": ["entity.name.function", "meta.function-call entity.name.function"],
			"settings": { "foreground": "#d0e8d8", "fontStyle": "bold" }
		},
		{
			"name": "Type/class names",
			"scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.name.module"],
			"settings": { "foreground": "#a0d8b4", "fontStyle": "bold" }
		},
		{
			"name": "HTML/JSX tags",
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#82c49e" }
		},
		{
			"name": "HTML/JSX attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#6ab0a2" }
		},
		{
			"name": "Inherited class",
			"scope": ["entity.other.inherited-class"],
			"settings": { "foreground": "#82c49e", "fontStyle": "italic" }
		},
		{
			"name": "Variables",
			"scope": ["variable", "variable.other"],
			"settings": { "foreground": "#d0e8d8" }
		},
		{
			"name": "Parameters",
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#a0d8b4", "fontStyle": "italic" }
		},
		{
			"name": "Object properties",
			"scope": ["variable.other.property", "variable.other.object.property"],
			"settings": { "foreground": "#a0c8a8" }
		},
		{
			"name": "Built-in functions",
			"scope": ["support.function"],
			"settings": { "foreground": "#82c49e" }
		},
		{
			"name": "Built-in types",
			"scope": ["support.type", "support.class"],
			"settings": { "foreground": "#6ab0a2" }
		},
		{
			"name": "Decorators/annotations",
			"scope": ["meta.decorator", "punctuation.decorator"],
			"settings": { "foreground": "#b090d0" }
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation", "meta.brace"],
			"settings": { "foreground": "#6ab0a2" }
		},
		{
			"name": "Import/export keywords",
			"scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from"],
			"settings": { "foreground": "#b090d0" }
		},
		{
			"name": "Markdown headings",
			"scope": ["markup.heading", "entity.name.section"],
			"settings": { "foreground": "#d0eca0", "fontStyle": "bold" }
		},
		{
			"name": "Markdown bold",
			"scope": ["markup.bold"],
			"settings": { "foreground": "#d0e8d8", "fontStyle": "bold" }
		},
		{
			"name": "Markdown italic",
			"scope": ["markup.italic"],
			"settings": { "foreground": "#a0d8b4", "fontStyle": "italic" }
		},
		{
			"name": "Markdown code",
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": { "foreground": "#82c49e" }
		},
		{
			"name": "Markdown links",
			"scope": ["markup.underline.link"],
			"settings": { "foreground": "#82c49e", "fontStyle": "underline" }
		},
		{
			"name": "Invalid",
			"scope": ["invalid"],
			"settings": { "foreground": "#b090d0" }
		},
		{
			"name": "Invalid deprecated",
			"scope": ["invalid.deprecated"],
			"settings": { "foreground": "#8a80d0", "fontStyle": "strikethrough" }
		},
		{
			"name": "JSON property names",
			"scope": ["support.type.property-name.json"],
			"settings": { "foreground": "#d0e8d8" }
		},
		{
			"name": "CSS property names",
			"scope": ["support.type.property-name.css", "meta.property-name"],
			"settings": { "foreground": "#a0d8b4" }
		},
		{
			"name": "CSS property values",
			"scope": ["support.constant.property-value.css"],
			"settings": { "foreground": "#82c49e" }
		},
		{
			"name": "CSS selectors",
			"scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
			"settings": { "foreground": "#82c49e" }
		},
		{
			"name": "Type annotations",
			"scope": ["meta.type.annotation", "meta.return.type"],
			"settings": { "foreground": "#6ab0a2" }
		},
		{
			"name": "this/self",
			"scope": ["variable.language.this", "variable.language.self", "variable.language.super"],
			"settings": { "foreground": "#b090d0", "fontStyle": "italic" }
		}
	]
}
