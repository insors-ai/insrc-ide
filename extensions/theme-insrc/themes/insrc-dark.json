		"button.secondaryBackground": "#18382680",
		"button.secondaryForeground": "#d0e8d8",
		"button.secondaryHoverBackground": "#2e3832",

		"list.activeSelectionBackground": "#183826",
		"list.activeSelectionForeground": "#d0e8d8",
		"list.activeSelectionIconForeground": "#82c49e",
		"list.hoverBackground": "#2e3832",
		"list.hoverForeground": "#d0e8d8",
		"list.focusBackground": "#183826",
		"list.focusForeground": "#d0e8d8",
		"list.focusOutline": "#82c49e",
		"list.inactiveSelectionBackground": "#222a26",
		"list.inactiveSelectionForeground": "#d0e8d8",
		"list.highlightForeground": "#a0d8b4",
		"list.dropBackground": "#18382660",
		"list.errorForeground": "#b090d0",
		"list.warningForeground": "#a0c840",

		"tree.indentGuidesStroke": "#2e3832",

		"badge.background": "#82c49e",
		"badge.foreground": "#121614",

		"scrollbar.shadow": "#00000040",
		"scrollbarSlider.background": "#3a4a4040",
		"scrollbarSlider.hoverBackground": "#3a4a4080",
		"scrollbarSlider.activeBackground": "#82c49e80",

		"progressBar.background": "#82c49e",

		"notifications.background": "#222a26",
		"notifications.foreground": "#d0e8d8",
		"notifications.border": "#2e3832",
		"notificationLink.foreground": "#82c49e",
		"notificationsErrorIcon.foreground": "#b090d0",
		"notificationsWarningIcon.foreground": "#a0c840",
		"notificationsInfoIcon.foreground": "#82c49e",

		"minimap.selectionHighlight": "#82c49e4d",
		"minimap.findMatchHighlight": "#a0c8404d",
		"minimap.errorHighlight": "#b090d04d",
		"minimap.warningHighlight": "#a0c8404d",

		"breadcrumb.foreground": "#a0d8b4",
		"breadcrumb.focusForeground": "#d0e8d8",
		"breadcrumb.activeSelectionForeground": "#82c49e",
		"breadcrumbPicker.background": "#222a26",

		"peekView.border": "#82c49e",
		"peekViewEditor.background": "#1a201e",
		"peekViewResult.background": "#222a26",
		"peekViewTitle.background": "#28302c",
		"peekViewEditor.matchHighlightBackground": "#2e383280",
		"peekViewResult.matchHighlightBackground": "#2e383280",

		"diffEditor.insertedTextBackground": "#1838264d",
		"diffEditor.removedTextBackground": "#1e08304d",
		"diffEditor.insertedLineBackground": "#18382630",
		"diffEditor.removedLineBackground": "#1e083030",

		"settings.headerForeground": "#d0e8d8",
		"settings.modifiedItemIndicator": "#82c49e",
		"settings.focusedRowBackground": "#222a26",

		"gitDecoration.addedResourceForeground": "#82c49e",
		"gitDecoration.modifiedResourceForeground": "#8a80d0",
		"gitDecoration.deletedResourceForeground": "#b090d0",
		"gitDecoration.renamedResourceForeground": "#82c49e",
		"gitDecoration.untrackedResourceForeground": "#6ab0a2",
		"gitDecoration.conflictingResourceForeground": "#a0c840",
		"gitDecoration.ignoredResourceForeground": "#6ab0a2",
		"gitDecoration.stageModifiedResourceForeground": "#8a80d0",
		"gitDecoration.stageDeletedResourceForeground": "#b090d0",

		"editorWidget.background": "#222a26",
		"editorWidget.border": "#2e3832",
		"editorWidget.foreground": "#d0e8d8",
		"editorSuggestWidget.background": "#222a26",
		"editorSuggestWidget.border": "#2e3832",
		"editorSuggestWidget.highlightForeground": "#82c49e",
		"editorSuggestWidget.selectedBackground": "#183826",

		"debugToolBar.background": "#222a26",
		"debugToolBar.border": "#2e3832",

		"welcomePage.tileBackground": "#222a26",
		"welcomePage.tileBorder": "#2e3832",
		"welcomePage.progress.foreground": "#82c49e",
