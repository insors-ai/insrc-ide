		"list.focusForeground": "#e8f5ee",
		"list.focusOutline": "#6AB489",
		"list.inactiveSelectionBackground": "#1f2b26",
		"list.inactiveSelectionForeground": "#e8f5ee",
		"list.highlightForeground": "#92CD87",
		"list.dropBackground": "#1a242060",
		"list.errorForeground": "#9060d0",
