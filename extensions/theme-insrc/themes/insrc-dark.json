		"badge.foreground": "#0d1210",

		"scrollbar.shadow": "#00000040",
		"scrollbarSlider.background": "#3d4e4840",
		"scrollbarSlider.hoverBackground": "#3d4e4880",
		"scrollbarSlider.activeBackground": "#6AB48980",

		"progressBar.background": "#6AB489",

		"notifications.background": "#1f2b26",
		"notifications.foreground": "#e8f5ee",
		"notifications.border": "#2e3b36",
		"notificationLink.foreground": "#6AB489",
		"notificationsErrorIcon.foreground": "#9060d0",
		"notificationsWarningIcon.foreground": "#88b800",
		"notificationsInfoIcon.foreground": "#6AB489",

		"minimap.selectionHighlight": "#6AB4894d",
		"minimap.findMatchHighlight": "#88b8004d",
		"minimap.errorHighlight": "#9060d04d",
		"minimap.warningHighlight": "#88b8004d",

		"breadcrumb.foreground": "#92CD87",
		"breadcrumb.focusForeground": "#e8f5ee",
		"breadcrumb.activeSelectionForeground": "#6AB489",
		"breadcrumbPicker.background": "#1f2b26",

		"peekView.border": "#6AB489",
