		"terminal.ansiCyan": "#4B9988",
		"terminal.ansiWhite": "#e8f5ee",
		"terminal.ansiBrightBlack": "#6a9478",
		"terminal.ansiBrightRed": "#9060d0",
		"terminal.ansiBrightGreen": "#92CD87",
		"terminal.ansiBrightYellow": "#D1E736",
