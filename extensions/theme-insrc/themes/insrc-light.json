		"terminal.ansiBlue": "#6a60b8",
		"terminal.ansiMagenta": "#7b5eaa",
		"terminal.ansiCyan": "#6ab0a2",
		"terminal.ansiWhite": "#e8f5ee",
		"terminal.ansiBrightBlack": "#8aaa92",
		"terminal.ansiBrightRed": "#a080c8",
		"terminal.ansiBrightGreen": "#a0d8b4",
		"terminal.ansiBrightYellow": "#e0f4b0",
		"terminal.ansiBrightBlue": "#8a80d0",
		"terminal.ansiBrightMagenta": "#a080c8",
		"terminal.ansiBrightCyan": "#82c49e",
		"terminal.ansiBrightWhite": "#ffffff",

		"input.background": "#fafcfb",
		"input.border": "#d0e0d6",
		"input.foreground": "#2a4a35",
		"input.placeholderForeground": "#8aaa92",
		"inputOption.activeBorder": "#6ab0a2",
		"inputOption.activeBackground": "#6ab0a230",
		"inputValidation.errorBackground": "#f0eaf8",
		"inputValidation.errorBorder": "#7b5eaa",
		"inputValidation.warningBackground": "#f0f4e0",
		"inputValidation.warningBorder": "#7a9930",
		"inputValidation.infoBackground": "#e8f4f0",
		"inputValidation.infoBorder": "#6ab0a2",

		"dropdown.background": "#fafcfb",
		"dropdown.border": "#d0e0d6",
		"dropdown.foreground": "#2a4a35",
		"dropdown.listBackground": "#fafcfb",

		"button.background": "#6ab0a2",
		"button.foreground": "#ffffff",
		"button.hoverBackground": "#5ea090",
		"button.secondaryBackground": "#e8f4f0",
		"button.secondaryForeground": "#2a4a35",
		"button.secondaryHoverBackground": "#d0ece0",

		"list.activeSelectionBackground": "#e8f4f0",
		"list.activeSelectionForeground": "#2a4a35",
		"list.activeSelectionIconForeground": "#6ab0a2",
		"list.hoverBackground": "#e0f0e6",
		"list.hoverForeground": "#2a4a35",
		"list.focusBackground": "#e8f4f0",
		"list.focusForeground": "#2a4a35",
		"list.focusOutline": "#6ab0a2",
		"list.inactiveSelectionBackground": "#f0f8f3",
		"list.inactiveSelectionForeground": "#2a4a35",
		"list.highlightForeground": "#5ea090",
		"list.dropBackground": "#e8f4f060",
		"list.errorForeground": "#7b5eaa",
		"list.warningForeground": "#7a9930",

		"tree.indentGuidesStroke": "#d0e0d6",

		"badge.background": "#6ab0a2",
		"badge.foreground": "#ffffff",

		"scrollbar.shadow": "#2a4a3510",
		"scrollbarSlider.background": "#b0ccb840",
		"scrollbarSlider.hoverBackground": "#b0ccb880",
		"scrollbarSlider.activeBackground": "#6ab0a280",

		"progressBar.background": "#6ab0a2",

		"notifications.background": "#fafcfb",
		"notifications.foreground": "#2a4a35",
		"notifications.border": "#d0e0d6",
		"notificationLink.foreground": "#6ab0a2",
		"notificationsErrorIcon.foreground": "#7b5eaa",
		"notificationsWarningIcon.foreground": "#7a9930",
		"notificationsInfoIcon.foreground": "#6ab0a2",

		"minimap.selectionHighlight": "#6ab0a24d",
		"minimap.findMatchHighlight": "#7a99304d",
		"minimap.errorHighlight": "#7b5eaa4d",
		"minimap.warningHighlight": "#7a99304d",

		"breadcrumb.foreground": "#4a7a5e",
		"breadcrumb.focusForeground": "#2a4a35",
		"breadcrumb.activeSelectionForeground": "#6ab0a2",
		"breadcrumbPicker.background": "#fafcfb",

		"peekView.border": "#6ab0a2",
		"peekViewEditor.background": "#fafcfb",
		"peekViewResult.background": "#f0f8f3",
		"peekViewTitle.background": "#e8f2ec",
		"peekViewEditor.matchHighlightBackground": "#c8e0d480",
		"peekViewResult.matchHighlightBackground": "#c8e0d480",

		"diffEditor.insertedTextBackground": "#d0ece04d",
		"diffEditor.removedTextBackground": "#f0eaf84d",
		"diffEditor.insertedLineBackground": "#d0ece030",
		"diffEditor.removedLineBackground": "#f0eaf830",

		"settings.headerForeground": "#2a4a35",
		"settings.modifiedItemIndicator": "#6ab0a2",
		"settings.focusedRowBackground": "#f0f8f3",

		"gitDecoration.addedResourceForeground": "#6ab0a2",
		"gitDecoration.modifiedResourceForeground": "#6a60b8",
		"gitDecoration.deletedResourceForeground": "#7b5eaa",
		"gitDecoration.renamedResourceForeground": "#6ab0a2",
		"gitDecoration.untrackedResourceForeground": "#6ab0a2",
		"gitDecoration.conflictingResourceForeground": "#7a9930",
		"gitDecoration.ignoredResourceForeground": "#8aaa92",
		"gitDecoration.stageModifiedResourceForeground": "#6a60b8",
		"gitDecoration.stageDeletedResourceForeground": "#7b5eaa",

		"editorWidget.background": "#fafcfb",
		"editorWidget.border": "#d0e0d6",
		"editorWidget.foreground": "#2a4a35",
		"editorSuggestWidget.background": "#fafcfb",
		"editorSuggestWidget.border": "#d0e0d6",
		"editorSuggestWidget.highlightForeground": "#6ab0a2",
		"editorSuggestWidget.selectedBackground": "#e8f4f0",

		"debugToolBar.background": "#f0f8f3",
		"debugToolBar.border": "#d0e0d6",

		"welcomePage.tileBackground": "#f0f8f3",
		"welcomePage.tileBorder": "#d0e0d6",
		"welcomePage.progress.foreground": "#6ab0a2",
		"walkThrough.embeddedEditorBackground": "#f0f8f3",

		"commandCenter.foreground": "#2a4a35",
		"commandCenter.background": "#f0f8f3",
		"commandCenter.border": "#d0e0d6",
		"commandCenter.activeForeground": "#2a4a35",
		"commandCenter.activeBackground": "#d0ece0"
	},
	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#8aaa92", "fontStyle": "italic" }
		},
		{
			"name": "Strings",
			"scope": ["string", "string.quoted"],
			"settings": { "foreground": "#6ab0a2" }
		},
		{
			"name": "Regular expressions",
			"scope": ["string.regexp"],
			"settings": { "foreground": "#5ea090" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#7a9930" }
		},
		{
			"name": "Language constants",
			"scope": ["constant.language"],
			"settings": { "foreground": "#7b5eaa" }
		},
		{
			"name": "Character escapes",
			"scope": ["constant.character.escape"],
			"settings": { "foreground": "#6a60b8" }
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "keyword.other"],
			"settings": { "foreground": "#7b5eaa" }
		},
		{
			"name": "Control keywords",
			"scope": ["keyword.control"],
			"settings": { "foreground": "#7b5eaa", "fontStyle": "bold" }
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#4a7a5e" }
		},
		{
			"name": "Storage types",
			"scope": ["storage.type", "storage"],
			"settings": { "foreground": "#6a60b8" }
		},
		{
			"name": "Storage modifiers",
			"scope": ["storage.modifier"],
			"settings": { "foreground": "#6a60b8", "fontStyle": "italic" }
		},
		{
			"name": "Function declarations",
			"scope": ["entity.name.function", "meta.function-call entity.name.function"],
			"settings": { "foreground": "#2a4a35", "fontStyle": "bold" }
		},
		{
			"name": "Type/class names",
			"scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.name.module"],
			"settings": { "foreground": "#4a7a5e", "fontStyle": "bold" }
		},
		{
			"name": "HTML/JSX tags",
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#5ea090" }
		},
		{
			"name": "HTML/JSX attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#6ab0a2" }
		},
		{
			"name": "Inherited class",
			"scope": ["entity.other.inherited-class"],
			"settings": { "foreground": "#6ab0a2", "fontStyle": "italic" }
		},
		{
			"name": "Variables",
			"scope": ["variable", "variable.other"],
			"settings": { "foreground": "#2a4a35" }
		},
		{
			"name": "Parameters",
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#4a7a5e", "fontStyle": "italic" }
		},
		{
			"name": "Object properties",
			"scope": ["variable.other.property", "variable.other.object.property"],
			"settings": { "foreground": "#4a7a5e" }
		},
		{
			"name": "Built-in functions",
			"scope": ["support.function"],
			"settings": { "foreground": "#6ab0a2" }
		},
		{
			"name": "Built-in types",
			"scope": ["support.type", "support.class"],
			"settings": { "foreground": "#7a9a8a" }
		},
		{
			"name": "Decorators/annotations",
			"scope": ["meta.decorator", "punctuation.decorator"],
			"settings": { "foreground": "#7b5eaa" }
		},
		{
			"name": "Punctuation",
			"scope": ["punctuation", "meta.brace"],
			"settings": { "foreground": "#8aaa92" }
		},
		{
			"name": "Import/export keywords",
			"scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from"],
			"settings": { "foreground": "#7b5eaa" }
		},
		{
			"name": "Markdown headings",
			"scope": ["markup.heading", "entity.name.section"],
			"settings": { "foreground": "#2a4a35", "fontStyle": "bold" }
		},
		{
			"name": "Markdown bold",
			"scope": ["markup.bold"],
			"settings": { "foreground": "#2a4a35", "fontStyle": "bold" }
		},
		{
			"name": "Markdown italic",
			"scope": ["markup.italic"],
			"settings": { "foreground": "#4a7a5e", "fontStyle": "italic" }
		},
		{
			"name": "Markdown code",
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": { "foreground": "#6ab0a2" }
		},
		{
			"name": "Markdown links",
			"scope": ["markup.underline.link"],
			"settings": { "foreground": "#6ab0a2", "fontStyle": "underline" }
		},
		{
			"name": "Invalid",
			"scope": ["invalid"],
			"settings": { "foreground": "#7b5eaa" }
		},
		{
			"name": "Invalid deprecated",
			"scope": ["invalid.deprecated"],
			"settings": { "foreground": "#6a60b8", "fontStyle": "strikethrough" }
		},
		{
			"name": "JSON property names",
			"scope": ["support.type.property-name.json"],
			"settings": { "foreground": "#2a4a35" }
		},
		{
			"name": "CSS property names",
			"scope": ["support.type.property-name.css", "meta.property-name"],
			"settings": { "foreground": "#4a7a5e" }
		},
		{
			"name": "CSS property values",
			"scope": ["support.constant.property-value.css"],
			"settings": { "foreground": "#6ab0a2" }
		},
		{
			"name": "CSS selectors",
			"scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
			"settings": { "foreground": "#5ea090" }
		},
		{
			"name": "Type annotations",
			"scope": ["meta.type.annotation", "meta.return.type"],
			"settings": { "foreground": "#7a9a8a" }
		},
		{
			"name": "this/self",
			"scope": ["variable.language.this", "variable.language.self", "variable.language.super"],
			"settings": { "foreground": "#7b5eaa", "fontStyle": "italic" }
		}
	]
}
