		"button.secondaryBackground": "#e4f2f0",
		"button.secondaryForeground": "#102D1A",
		"button.secondaryHoverBackground": "#daeae0",

		"list.activeSelectionBackground": "#e4f2f0",
		"list.activeSelectionForeground": "#102D1A",
		"list.activeSelectionIconForeground": "#4B9988",
		"list.hoverBackground": "#daeae0",
		"list.hoverForeground": "#102D1A",
		"list.focusBackground": "#e4f2f0",
		"list.focusForeground": "#102D1A",
		"list.focusOutline": "#4B9988",
		"list.inactiveSelectionBackground": "#eef6f1",
		"list.inactiveSelectionForeground": "#102D1A",
		"list.highlightForeground": "#3d8070",
		"list.dropBackground": "#e4f2f060",
		"list.errorForeground": "#5c3090",
		"list.warningForeground": "#5a7a00",

		"tree.indentGuidesStroke": "#c2d9ca",

		"badge.background": "#4B9988",
		"badge.foreground": "#ffffff",

		"scrollbar.shadow": "#102d1a10",
		"scrollbarSlider.background": "#9ebfaa40",
		"scrollbarSlider.hoverBackground": "#9ebfaa80",
		"scrollbarSlider.activeBackground": "#4B998880",

		"progressBar.background": "#4B9988",

		"notifications.background": "#f8fbf9",
		"notifications.foreground": "#102D1A",
		"notifications.border": "#c2d9ca",
		"notificationLink.foreground": "#4B9988",
		"notificationsErrorIcon.foreground": "#5c3090",
		"notificationsWarningIcon.foreground": "#5a7a00",
		"notificationsInfoIcon.foreground": "#4B9988",

		"minimap.selectionHighlight": "#4B99884d",
		"minimap.findMatchHighlight": "#5a7a004d",
		"minimap.errorHighlight": "#5c30904d",
		"minimap.warningHighlight": "#5a7a004d",

		"breadcrumb.foreground": "#2d5c3e",
		"breadcrumb.focusForeground": "#102D1A",
		"breadcrumb.activeSelectionForeground": "#4B9988",
		"breadcrumbPicker.background": "#f8fbf9",

		"peekView.border": "#4B9988",
		"peekViewEditor.background": "#f8fbf9",
		"peekViewResult.background": "#eef6f1",
		"peekViewTitle.background": "#e4f0e8",
		"peekViewEditor.matchHighlightBackground": "#daeae080",
		"peekViewResult.matchHighlightBackground": "#daeae080",

		"diffEditor.insertedTextBackground": "#e4f2f04d",
		"diffEditor.removedTextBackground": "#eeeafc4d",
		"diffEditor.insertedLineBackground": "#e4f2f030",
		"diffEditor.removedLineBackground": "#eeeafc30",

		"settings.headerForeground": "#102D1A",
		"settings.modifiedItemIndicator": "#4B9988",
		"settings.focusedRowBackground": "#eef6f1",

		"gitDecoration.addedResourceForeground": "#4B9988",
		"gitDecoration.modifiedResourceForeground": "#4838a0",
		"gitDecoration.deletedResourceForeground": "#5c3090",
		"gitDecoration.renamedResourceForeground": "#4B9988",
		"gitDecoration.untrackedResourceForeground": "#4B9988",
		"gitDecoration.conflictingResourceForeground": "#5a7a00",
		"gitDecoration.ignoredResourceForeground": "#6a9478",
		"gitDecoration.stageModifiedResourceForeground": "#4838a0",
		"gitDecoration.stageDeletedResourceForeground": "#5c3090",

		"editorWidget.background": "#f8fbf9",
		"editorWidget.border": "#c2d9ca",
		"editorWidget.foreground": "#102D1A",
		"editorSuggestWidget.background": "#f8fbf9",
		"editorSuggestWidget.border": "#c2d9ca",
		"editorSuggestWidget.highlightForeground": "#4B9988",
		"editorSuggestWidget.selectedBackground": "#e4f2f0",

		"debugToolBar.background": "#eef6f1",
		"debugToolBar.border": "#c2d9ca",

		"welcomePage.tileBackground": "#eef6f1",
		"welcomePage.tileBorder": "#c2d9ca",
		"welcomePage.progress.foreground": "#4B9988",
		"walkThrough.embeddedEditorBackground": "#eef6f1",

		"commandCenter.foreground": "#C2E484",
		"commandCenter.background": "#102D1A",
		"commandCenter.border": "#102D1A",
		"commandCenter.activeForeground": "#ffffff",
		"commandCenter.activeBackground": "#6AB48930"
