		"inputOption.activeBorder": "#4B9988",
		"inputOption.activeBackground": "#4B998830",
		"inputValidation.errorBackground": "#eeeafc",
		"inputValidation.errorBorder": "#5c3090",
		"inputValidation.warningBackground": "#eaf2d4",
		"inputValidation.warningBorder": "#5a7a00",
		"inputValidation.infoBackground": "#e4f2f0",
		"inputValidation.infoBorder": "#4B9988",

		"dropdown.background": "#f8fbf9",
		"dropdown.border": "#c2d9ca",
