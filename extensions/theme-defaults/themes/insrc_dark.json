		"sideBarSectionHeader.border": "#1c2740",
		"sideBarSectionHeader.foreground": "#e3eaf6",
		"sideBarTitle.foreground": "#e3eaf6",
		"statusBar.background": "#0b1420",
		"statusBar.border": "#1c2740",
		"statusBar.debuggingBackground": "#566eff",
		"statusBar.debuggingForeground": "#ffffff",
		"statusBar.focusBorder": "#56a0ff",
		"statusBar.foreground": "#e3eaf6",
		"statusBar.noFolderBackground": "#101927",
